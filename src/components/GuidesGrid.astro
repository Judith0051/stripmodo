---
import { getCollection } from 'astro:content';
import { GUIDES } from '../consts';
import { url } from '../utils/url';

const articles = await getCollection('articles');
const byId = new Map(articles.map((a) => [a.id, a]));
const guides = GUIDES.map((g) => byId.get(g.slug)).filter(Boolean);
---

<section aria-labelledby="all-guides">
  <h2 id="all-guides">All guides on this site</h2>
  <p>
    Seven in-depth guides, one shared goal: help you use StripChat tokens
    safely, understand what you pay for, and avoid the traps.
  </p>
  <div class="card-grid">
    {guides.map((a) => a && (
      <a class="card" href={url(`/${a.id}/`)}>
        <h3>{a.data.cardTitle ?? a.data.h1}</h3>
        <p>{a.data.cardDescription ?? a.data.description}</p>
        <span class="card__go">Read the guide<span aria-hidden="true"> →</span></span>
      </a>
    ))}
  </div>
</section>
