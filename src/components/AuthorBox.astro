---
import { SITE } from '../consts';
import { url } from '../utils/url';
---

<div class="author-box">
  <svg width="34" height="34" viewBox="0 0 34 34" fill="none" aria-hidden="true">
    <rect width="34" height="34" rx="9" fill="#0a5d4a"></rect>
    <path d="M10 21.5l4.9 4.9L24.5 14.5" stroke="#fff" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <div>
    <h2>About the author — {SITE.author}</h2>
    <p>
      {SITE.authorDescription} Questions or corrections?
      <a href={url('/contact/')}>Contact us</a> and read our
      <a href={url('/editorial-policy/')}>editorial policy</a> for how we review
      claims and external links.
    </p>
  </div>
</div>
