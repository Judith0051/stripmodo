---
import { getEntry, render } from 'astro:content';
import ArticleLayout from '../layouts/ArticleLayout.astro';
import { organizationSchema, websiteSchema } from '../utils/schema';

const entry = await getEntry('articles', 'index');
if (!entry) throw new Error('Homepage article (index.md) is missing');
const { Content, headings } = await render(entry);
---

<ArticleLayout entry={entry} headings={headings} eagerImage extraJsonLd={[organizationSchema(), websiteSchema()]}>
  <Content />
</ArticleLayout>
