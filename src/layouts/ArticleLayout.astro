---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TOC from '../components/TOC.astro';
import VideoSection from '../components/VideoSection.astro';
import DisclosureBox from '../components/DisclosureBox.astro';
import AuthorBox from '../components/AuthorBox.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import GuidesGrid from '../components/GuidesGrid.astro';
import { SITE } from '../consts';
import { articleSchema, faqSchema, videoSchema } from '../utils/schema';
import { formatDate, url } from '../utils/url';
import { wordCount } from '../utils/words';

interface Props {
  entry: CollectionEntry<'articles'>;
  headings: MarkdownHeading[];
  /** Render the featured image eagerly (homepage LCP image). */
  eagerImage?: boolean;
  /** Additional JSON-LD objects (e.g. Organization/WebSite on the homepage). */
  extraJsonLd?: Record<string, unknown>[];
}

const { entry, headings, eagerImage = false, extraJsonLd = [] } = Astro.props;
const { data } = entry;
const path = entry.id === 'index' ? '/' : `/${entry.id}/`;

const words = wordCount(entry.body ?? '');
const minutes = Math.max(1, Math.round(words / 200));

const jsonLd: Record<string, unknown>[] = [
  articleSchema({
    headline: data.h1,
    description: data.description,
    path,
    pubDate: data.pubDate,
    updatedDate: data.updatedDate,
    wordCount: words,
  }),
  videoSchema(path),
  ...extraJsonLd,
];
if (data.faqs?.length) jsonLd.push(faqSchema(data.faqs));
---

<Base
  title={data.title}
  description={data.description}
  path={path}
  type="article"
  pubDate={data.pubDate.toISOString()}
  updatedDate={data.updatedDate.toISOString()}
  jsonLd={jsonLd}
  hasVideo
>
  <Breadcrumbs items={entry.id === 'index' ? [] : [{ label: data.navLabel ?? data.h1 }]} />

  <article class={entry.id === 'index' ? '' : 'container'}>
    {entry.id === 'index' ? (
      <header class="home-hero">
        <div class="container home-hero__inner">
          <h1>{data.h1}</h1>
          <p class="home-hero__lede">{data.description}</p>
          <div class="home-hero__cta">
            <a class="btn" href={url('/stripchat-free-tokens/')}>Read the free-tokens guide</a>
            <a class="btn btn--outline" href={url('/stripchat-token-scams/')}>See the scam warnings</a>
          </div>
          <ul class="home-hero__facts">
            <li>Independently researched</li>
            <li>Updated {SITE.updatedLong}</li>
            <li>No sign-up, no data collected</li>
          </ul>
          <div class="article-meta" style="margin-top: 1rem;">
            <span>By <strong><a href={url('/editorial-policy/')} style="color: inherit;">{SITE.author}</a></strong></span>
            <span>Published <time datetime={data.pubDate.toISOString().slice(0, 10)}>{formatDate(data.pubDate)}</time></span>
            <span>Last updated: <time datetime={data.updatedDate.toISOString().slice(0, 10)}>{formatDate(data.updatedDate)}</time></span>
            <span>{minutes} min read</span>
          </div>
          <span class="age-note">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <circle cx="6.5" cy="6.5" r="5.3" stroke="currentColor" stroke-width="1.3"></circle>
              <path d="M6.5 3.7v3M6.5 8.6v.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
            Adults only (18+): StripChat is an adult live-streaming platform.
          </span>
        </div>
      </header>
    ) : (
      <div class="container">
        <header class="article-head prose">
          <h1>{data.h1}</h1>
          <div class="article-meta">
            <span>By <strong><a href={url('/editorial-policy/')} style="color: inherit;">{SITE.author}</a></strong></span>
            <span>Published <time datetime={data.pubDate.toISOString().slice(0, 10)}>{formatDate(data.pubDate)}</time></span>
            <span>Last updated: <time datetime={data.updatedDate.toISOString().slice(0, 10)}>{formatDate(data.updatedDate)}</time></span>
            <span>{minutes} min read</span>
          </div>
          <span class="age-note">
            <svg width="13" height="13" viewBox="0 0 13 13" fill="none" aria-hidden="true">
              <circle cx="6.5" cy="6.5" r="5.3" stroke="currentColor" stroke-width="1.3"></circle>
              <path d="M6.5 3.7v3M6.5 8.6v.1" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"></path>
            </svg>
            Adults only (18+): StripChat is an adult live-streaming platform.
          </span>
        </header>
      </div>
    )}

    <div class="container">

    <div class="prose">
      <VideoSection />
      <TOC headings={headings} />
      <DisclosureBox />
    </div>

    {data.featured && data.featuredAlt && (
      <figure class="prose" style="margin: 0 0 1.5rem;">
        <Image
          src={data.featured}
          alt={data.featuredAlt}
          width={736}
          widths={[480, 736]}
          sizes="(max-width: 46rem) 100vw, 736px"
          format="webp"
          quality={70}
          loading={eagerImage ? 'eager' : 'lazy'}
          fetchpriority={eagerImage ? 'high' : undefined}
          style="width: 100%; height: auto; border-radius: 10px; border: 1px solid var(--border);"
        />
        {data.featuredCaption && (
          <figcaption style="font-size: 0.85rem; color: var(--muted); margin-top: 0.5rem;">
            {data.featuredCaption}
          </figcaption>
        )}
      </figure>
    )}

    <div class="prose">
      <slot />
    </div>

    <div class="prose">
      {entry.id === 'index' && <GuidesGrid />}
      <AuthorBox />
      {entry.id !== 'index' && <RelatedGuides current={entry.id} featured={data.related} />}
    </div>
    </div>
  </article>
</Base>
